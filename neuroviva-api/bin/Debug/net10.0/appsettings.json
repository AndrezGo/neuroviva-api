{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "<<SET_VIA_ENV: Database__ConnectionString>>",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Supabase": {
    "Url": "<<SET_VIA_ENV: Supabase__Url>>",
    "AnonKey": "<<SET_VIA_ENV: Supabase__AnonKey>>",
    "JwtIssuer": "<<SET_VIA_ENV: Supabase__JwtIssuer>>",
    "JwtAudience": "authenticated",
    "JwksUrl": "<<SET_VIA_ENV: Supabase__JwksUrl>>"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Default": { "PermitLimit": 100, "WindowSeconds": 60 },
    "Write":   { "PermitLimit": 30,  "WindowSeconds": 60 },
    "Ai":      { "PermitLimit": 20,  "WindowSeconds": 3600 }
  },
  "Ai": {
    "Provider": "OpenAI",
    "OpenAI": { "ApiKey": "<<SET_VIA_ENV: Ai__OpenAI__ApiKey>>", "Model": "gpt-4o-mini" },
    "Groq": { "ApiKey": "<<SET_VIA_ENV: Ai__Groq__ApiKey>>", "Model": "llama-3.1-70b-versatile" }
  },
  "Notifications": {
    "Push": { "FirebaseCredentialsPath": "<<SET_VIA_ENV>>" },
    "Email": { "SmtpHost": "<<SET_VIA_ENV>>", "SmtpPort": 587, "User": "<<SET_VIA_ENV>>", "Pass": "<<SET_VIA_ENV>>" },
    "Sms": { "TwilioAccountSid": "<<SET_VIA_ENV>>", "TwilioAuthToken": "<<SET_VIA_ENV>>", "FromNumber": "<<SET_VIA_ENV>>" }
  },
  "Storage": {
    "Provider": "Supabase",
    "Bucket": "neuroviva-public"
  },
  "Payments": {
    "Provider": "Wompi",
    "Wompi": {
      "PublicKey": "<<SET_VIA_ENV>>",
      "PrivateKey": "<<SET_VIA_ENV: Payments__Wompi__PrivateKey>>",
      "EventsKey": "<<SET_VIA_ENV: Payments__Wompi__EventsKey>>",
      "BaseUrl": "https://production.wompi.co/v1"
    }
  },
  "AllowedHosts": "*"
}
